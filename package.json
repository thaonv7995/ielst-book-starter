{
  "name": "ielts-book-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 38080",
    "serve": "node server.js",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "status": "pm2 status",
    "logs": "pm2 logs ielts-book-web",
    "prod": "npm run build && (pm2 restart ecosystem.config.cjs || pm2 start ecosystem.config.cjs)",
    "release:pack": "npm run build && tar -czf ielst-book-starter-standalone.tar.gz dist server.js ecosystem.config.cjs package.json package-lock.json README.md install.sh",
    "extract": "python3 scripts/extract-pages.py",
    "extract:text": "python3 scripts/extract-text.py"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "typescript": "~5.7.0",
    "vite": "~6.0.0"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "pm2": "^7.0.4"
  }
}
